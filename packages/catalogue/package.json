{
  "name": "@bedalton/caos-editor-interop",
  "version": "0.0.1",
  "description": "Shared definitions for LSP server and client",
  "main": "./dist/index.js",
  "browser": "./dist/index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "directory": "packages/interop",
    "url": "https://github.com/bedalton/caos-language-server"
  },
  "exports": {
    ".": "./dist/index.js",
    "./vfs": "./dist/vfs.js"
  },
  "scripts": {
    "clean": "rimraf dist && rimraf tsconfig.tsbuildinfo && mkdir -p dist",
    "prepack": "yarn build",
    "build": "yarn clean && tsc --build && cp \"./package.json\" ./dist/",
    "test": "echo 'no test'",
    "lint": "eslint \"./src/**/*.{ts,tsx}\" --max-warnings=0",
    "webpack": "yarn clean && tsc --build",
    "postversion": "webpack --mode development --watch",
    "package": "webpack --mode production --devtool hidden-source-map"
  },
  "dependencies": {
    "@bedalton/extension-util": "*",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.5"
  },
  "devDependencies": {
    "rimraf": "^3.0.2"
  }
}
