{
  "name": "@creatures-lsp/catalogue",
  "version": "0.0.8",
  "type": "module",
  "description": "Catalogue",
  "main": "./dist/index.js",
  "browser": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "directory": "packages/catalogue",
    "url": "https://github.com/creatureslsp/creatures-lsp"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./range": {
      "default": "./dist/range.js",
      "types": "./dist/range.d.ts"
    },
    "./completions": {
      "default": "./dist/completions.js",
      "types": "./dist/completions.d.ts"
    },
    "./is": {
      "default": "./dist/is.js",
      "types": "./dist/is.d.ts"
    },
    "./semantic-highlighter": {
      "default": "./dist/semantic-highlighter.js",
      "types": "./dist/semantic-highlighter.d.ts"
    },
    "./semantics-legend": {
      "default": "./dist/semantics-legend.js",
      "types": "./dist/semantics-legend.d.ts"
    },
    "./formatter": {
      "default": "./dist/formatter.js",
      "types": "./dist/formatter.d.ts"
    },
    "./validation": {
      "default": "./dist/validation.js",
      "types": "./dist/validation.d.ts"
    },
    "./core": {
      "default": "./dist/core.js",
      "types": "./dist/core.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist && rimraf tsconfig.tsbuildinfo && mkdir -p dist",
    "copy-files": "cp \"./package.json\" ./dist/",
    "build": "yarn copy-files && tsc --build",
    "test": "echo 'no test'",
    "lint": "eslint \"./src/**/*.{ts,tsx}\" --max-warnings=0"
  },
  "dependencies": {
    "@creatures-lsp/extension-util": "0.0.8",
    "@creatures-lsp/caos-kt": "0.0.8",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.5"
  },
  "devDependencies": {
    "rimraf": "^6.1.3"
  }
}
