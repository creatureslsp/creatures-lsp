{
  "name": "@creatureslsp/server",
  "displayName": "Creatures-LSP: Server",
  "type": "module",
  "license": "MIT",
  "description": "A language server for Creature's CAOS language",
  "version": "0.0.2",
  "engines": {
    "node": "*"
  },
  "main": "./dist/node/server.cjs",
  "browser": "./dist/web/server.cjs",
  "bin": {
    "caos-language-server": "dist/node/server.cjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "npm-publish": "npm publish",
    "clean": "rimraf dist && rimraf tsconfig.tsbuildinfo && mkdir -p ./dist",
    "prepack": "yarn clean && yarn copy-files && yarn build && yarn webpack",
    "copy-files": "cp \"./package.json\" ./dist/",
    "build": "tsc --build",
    "lint": "eslint \"./src/**/*.{ts,tsx}\" --max-warnings=0",
    "prependHashBang": "echo \"#! /usr/bin/env node\" > ./dist/node/temp.cjs && cat ./dist/node/server.cjs >> ./dist/node/temp.cjs && rm ./dist/node/server.cjs && mv ./dist/node/temp.cjs ./dist/node/server.cjs && chmod +x ./dist/node/server.cjs",
    "webpack": "webpack --mode development && yarn prependHashBang",
    "package": "webpack --mode production --devtool hidden-source-map",
    "test": "echo 'no test'"
  },
  "files": [
    "dist/node/server.cjs",
    "dist/web/server.cjs"
  ],
  "repository": {
    "type": "git",
    "directory": "packages/server",
    "url": "https://github.com/creatureslsp/creatures-lsp"
  },
  "dependencies": {
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.11"
  },
  "devDependencies": {
    "@creatureslsp/caos": "0.0.2",
    "@creatureslsp/caos-kt": "0.0.2",
    "@creatureslsp/catalogue": "0.0.2",
    "@creatureslsp/extension-util": "0.0.2",
    "rimraf": "^6.1.3"
  },
  "gitHead": "2da6bd9bdc7af39861033140c010c209728ea72c"
}
