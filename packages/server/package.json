{
  "name": "@bedalton/caos-language-server",
  "author": "bedalton",
  "displayName": "CAOSEditor",
  "license": "MIT",
  "description": "A language server for Creature's CAOS language",
  "version": "0.0.1",
  "engines": {
    "node": "*"
  },
  "main": "./dist/server.js",
  "browser": "./dist/web/server.js",
  "bin": "./dist/server.js",
  "scripts": {
    "clean": "rimraf dist && rimraf tsconfig.tsbuildinfo",
    "prepack": "yarn build",
    "build": "yarn clean && tsc --build && cp \"./package.json\" ./dist/",
    "test": "echo 'no test'",
    "lint": "eslint \"./src/**/*.{ts,tsx}\" --max-warnings=0",
    "webpack": "yarn clean && tsc --build && webpack --mode development",
    "postversion": "webpack --mode development --watch",
    "package": "webpack --mode production --devtool hidden-source-map"
  },
  "files": [
    "./dist"
  ],
  "repository": {
    "type": "git",
    "directory": "packages/server",
    "url": "https://github.com/bedalton/caos-language-server"
  },
  "dependencies": {
    "@bedalton/caos-util": "*",
    "rimraf": "^3.0.2",
    "vscode-languageserver": "^8.0.1",
    "vscode-languageserver-textdocument": "^1.0.5"
  }
}
