{
  "name": "@bedalton/caos-util",
  "version": "0.0.1",
  "description": "Utility methods for parsing and validating CAOS scripts for the Creatures games",
  "types": "./lib/caos-util.d.ts",
  "main": "lib/caos-util.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "directory": "packages/caos-util",
    "url": "https://github.com/bedalton/caos-language-server"
  },
  "exports": {
    ".": "./lib/caos-util.js",
    "./commands": "./lib/commands.js",
    "./completions": "./lib/completions.js",
    "./constants": "./lib/constants.js",
    "./context-walker": "./lib/context-walker.js",
    "./cursor-data": "./lib/cursor-data.js",
    "./formatter": "./lib/formatter.js",
    "./goto": "./lib/goto.js",
    "./hash-util": "./lib/hash-util.js",
    "./hover-documentation": "./lib/hover-documentation.js",
    "./inlay-hints": "./lib/inlay-hints.js",
    "./is-similar": "./lib/is-similar.js",
    "./position-utils": "./lib/position-utils.js",
    "./repack": "./lib/repack.js",
    "./semantic-highlighter": "./lib/semantic-highlighter.js",
    "./server": "./src/server.d.ts",
    "./subroutines": "./lib/subroutines.js",
    "./token-range": "./lib/token-range.js"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "clean": "rimraf lib && rimraf tsconfig.tsbuildinfo && mkdir -p lib",
    "prepack": "yarn build",
    "build": "yarn clean &&  find ./src -type f \\( -iname \\*.js -o -iname \\*.js.map -o -iname \\*.json -o -iname \\*.d.ts \\) -exec cp {} ./lib/ \\; && tsc --build",
    "test": "echo 'no test'",
    "lint": "eslint \"./src/**/*.{ts,tsx}\" --max-warnings=0"
  },
  "typesVersions": {
    "*": {
      ".": [
        "./lib/CaosUtil.d.ts"
      ],
      "./commands": [
        "./lib/commands.d.ts"
      ],
      "./completions": [
        "./lib/completions.d.ts"
      ],
      "./constants": [
        "./lib/constants.d.ts"
      ],
      "./context-walker": [
        "./lib/context-walker.d.ts"
      ],
      "./cursor-data": [
        "./lib/cursor-data.d.ts"
      ],
      "./formatter": [
        "./lib/formatter.d.ts"
      ],
      "./goto": [
        "./lib/goto.d.ts"
      ],
      "./hash-util": [
        "./lib/hash-util.d.ts"
      ],
      "./hover-documentation": [
        "./lib/hover-documentation.d.ts"
      ],
      "./inlay-hints": [
        "./lib/inlay-hints.d.ts"
      ],
      "./is-similar": [
        "./lib/is-similar.d.ts"
      ],
      "./position-utils": [
        "./lib/position-utils.d.ts"
      ],
      "./repack": [
        "./lib/repack.d.ts"
      ],
      "./semantic-highlighter": [
        "./lib/semantic-highlighter.d.ts"
      ],
      "./server": [
        "./src/server.d.ts"
      ],
      "./subroutines": [
        "./lib/subroutines.d.ts"
      ],
      "./token-range": [
        "./lib/token-range.d.ts"
      ]
    }
  },
  "devDependencies": {
    "rimraf": "^3.0.2",
    "vscode-languageserver-types": "^3.17.1"
  }
}
