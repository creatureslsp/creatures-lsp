	32813 = Attention (Disabled)
	32814 = Actions (Disabled)
	32815 = Senses (Disabled)
	32816 = Stimuli (Disabled)
	32817 = Genetics (Disabled)
	32818 = Life changes (Disabled)
	32819 = Environment (Disabled)
	32820 = User (Disabled)
	32821 = OLE events (Disabled)
