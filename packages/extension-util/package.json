{
  "name": "@bedalton/extension-util",
  "author": "bedalton",
  "displayName": "AST-Util",
  "license": "MIT",
  "description": "Helper functions for dealing with language extensions",
  "version": "0.0.1",
  "engines": {
    "node": "*"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "clean": "rimraf dist && rimraf tsconfig.tsbuildinfo",
    "prepack": "yarn build",
    "build": "yarn clean && tsc --build && cp \"./package.json\" ./dist/ && find \"./src\" -name \"*.d.ts\" -exec cp -LR {} ./dist \\; && rm ./dist/index.d.ts && cp ./src/_index.d.ts ./dist/index.d.ts",
    "webpack": "yarn run build",
    "test": "echo 'no test'",
    "lint": "eslint \"./src/**/*.{ts,tsx}\" --max-warnings=0"
  },
  "files": [
    "./dist"
  ],
  "repository": {
    "type": "git",
    "directory": "packages/extension-util",
    "url": "https://github.com/bedalton/caos-language-server"
  },
  "dependencies": {
    "rimraf": "^3.0.2",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.5"
  }
}
