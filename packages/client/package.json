{
  "name": "@bedalton/caos-vscode-client",
  "displayName": "CAOSEditor",
  "description": "An editor for the Creature's CAOS language",
  "version": "0.0.1",
  "main": "./dist/node/extension.js",
  "browser": "./dist/web/extension.js",
  "types": "./dist/extension.d.ts",
  "license": "MIT",
  "engines": {
    "vscode": "^1.72.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "repository": {
    "type": "git",
    "directory": "packages/client",
    "url": "https://github.com/bedalton/caos-language-server"
  },
  "dependencies": {
    "@bedalton/caos-util": "*",
    "vscode-languageclient": "^9.0.1"
  },
  "scripts": {
    "clean": "rimraf dist && rimraf tsconfig.tsbuildinfo",
    "prepack": "yarn build",
    "build": "yarn clean && tsc --build && cp \"./package.json\" ./dist/",
    "test": "echo 'no test'",
    "lint": "eslint \"./src/**/*.{ts,tsx}\" --max-warnings=0",
    "webpack": "webpack --mode development",
    "postversion": "webpack --mode development --watch",
    "package": "webpack --mode production --devtool hidden-source-map"
  },
  "files": [
    "./dist"
  ],
  "devDependencies": {
    "@types/node": "^17.0.40",
    "@types/vscode": "^1.81.0",
    "@vscode/test-electron": "^2.1.2",
    "rimraf": "^3.0.2",
    "@vscode/test-web": "^0.0.48"
  },
  "exports": {
    ".": {
      "default": "./extension.js"
    }
  },
  "extensionDependencies": []
}
