{
  "name": "@creatures-lsp/vs-client",
  "type": "module",
  "displayName": "CAOSEditor",
  "description": "An editor for the Creature's CAOS language",
  "version": "0.0.8",
  "main": "./dist/node/extension.cjs",
  "browser": "./dist/web/extension.cjs",
  "types": "./dist/extension.d.ts",
  "license": "MIT",
  "engines": {
    "vscode": "^1.72.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "directory": "packages/client",
    "url": "https://github.com/bedalton/caos-language-server"
  },
  "scripts": {
    "clean": "rimraf dist && rimraf tsconfig.tsbuildinfo",
    "prepack": "yarn build",
    "build": "tsc --build && cp \"./package.json\" ./dist/",
    "test": "echo 'no test'",
    "lint": "eslint \"./src/**/*.{mts,ts,tsx}\" --max-warnings=0",
    "webpack": "webpack --mode development --devtool cheap-source-map",
    "package": "webpack --mode production --devtool hidden-source-map"
  },
  "files": [
    "./dist/node/extension.cjs",
    "./dist/web/extension.cjs"
  ],
  "dependencies": {
    "@creatures-lsp/caos": "0.0.8",
    "@creatures-lsp/catalogue": "0.0.8",
    "@creatures-lsp/extension-util": "0.0.8",
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^17.0.40",
    "@types/vscode": "^1.81.0",
    "@vscode/test-electron": "^2.1.2",
    "rimraf": "^6.1.3",
    "@vscode/test-web": "^0.0.48"
  },
  "exports": {
    ".": {
      "default": "./dist/node/extension.cjs"
    }
  },
  "extensionDependencies": []
}
